import { NextRequest, NextResponse } from "next/server";
import { triggerCollection, getProgress, fetchSnapshot, ingererPostes } from "@/lib/brightdata";

export const dynamic = "force-dynamic";
export const maxDuration = 60; // secondes — ajuste selon ton plan Vercel

// POST => déclenche une collecte, renvoie { snapshot_id }
export async function POST() {
  try {
    const profil = process.env.LINKEDIN_PROFILE_URL;
    if (!profil) {
      return NextResponse.json({ error: "LINKEDIN_PROFILE_URL manquant" }, { status: 400 });
    }
    const snapshot_id = await triggerCollection([profil]);
    return NextResponse.json({ snapshot_id, status: "running" });
  } catch (e: any) {
    return NextResponse.json({ error: e.message }, { status: 500 });
  }
}

// GET ?snapshot_id=... => vérifie l'état ; si prêt, ingère et renvoie le nombre de postes
export async function GET(req: NextRequest) {
  try {
    const snapshotId = req.nextUrl.searchParams.get("snapshot_id");
    if (!snapshotId) {
      return NextResponse.json({ error: "snapshot_id requis" }, { status: 400 });
    }

    const progress = await getProgress(snapshotId);
    if (progress.status !== "ready") {
      return NextResponse.json({ status: progress.status ?? "running" });
    }

    const donnees = await fetchSnapshot(snapshotId);
    const traites = await ingererPostes(donnees);
    return NextResponse.json({ status: "ready", postes_traites: traites });
  } catch (e: any) {
    return NextResponse.json({ error: e.message }, { status: 500 });
  }
}